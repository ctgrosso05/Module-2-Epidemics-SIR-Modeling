    "script_dir = os.path.dirname(os.path.abspath(\"__file__\"))\n",
    "\n",
    "data_path = os.path.join(script_dir, \"..\", \"Data\", \"mystery_virus_daily_active_counts_RELEASE#2.csv\")\n",
    "data = pd.read_csv(data_path, parse_dates=['date'])\n",
    "\n",
    "exp_data = data[(data['day'] >= 20) & (data['day'] <= 100)]\n",
    "\n",
    "# ============================================================\n",
    "# SEIR SETUP\n",
    "# ============================================================\n",
    "N = 10000\n",
    "t_start = 0\n",
    "dt = 0.1\n",
    "t = np.arange(t_start, 100, dt)\n",
    "t_extended = np.arange(t_start, 200, dt)\n",
    "\n",
    "# ============================================================\n",
    "# EULER SEIR FUNCTION\n",
    "# ============================================================\n",
    "def euler_seir(beta, sigma, gamma, S0, E0, I0, R0, timepoints, N):\n",
    "    dt = timepoints[1] - timepoints[0]\n",
    "    S = [S0]\n",
    "    E = [E0]\n",
    "    I = [I0]\n",
    "    R = [R0]\n",
    "    for i in range(1, len(timepoints)):\n",
    "        dS = -beta * S[-1] * I[-1] / N\n",
    "        dE = beta * S[-1] * I[-1] / N - sigma * E[-1]\n",
    "        dI = sigma * E[-1] - gamma * I[-1]\n",
    "        dR = gamma * I[-1]\n",
    "        S.append(S[-1] + dt * dS)\n",
    "        E.append(E[-1] + dt * dE)\n",
    "        I.append(I[-1] + dt * dI)\n",
    "        R.append(R[-1] + dt * dR)\n",
    "    return S, E, I, R\n",
    "\n",
    "# ============================================================\n",
    "# GRID SEARCH TO FIT PARAMETERS\n",
    "# ============================================================\n",
    "def fit_seir_parameters(timepoints, N, S0, E0, I0, R0, data):\n",
    "    beta_range = np.linspace(0.1, 1.0, 10)\n",
    "    sigma_range = np.linspace(0.1, 0.5, 10)\n",
    "    gamma_range = np.linspace(0.05, 0.3, 10)\n",
    "\n",
    "    SSE_array = []\n",
    "    param_combinations = []\n",
    "\n",
    "    for b in beta_range:\n",
    "        for s in sigma_range:\n",
    "            for g in gamma_range:\n",
    "                S, E, I_sim, R = euler_seir(b, s, g, S0, E0, I0, R0, timepoints, N)\n",
    "                data_days = data['day'].values\n",
    "                sim_I_at_data_days = np.interp(data_days, timepoints, I_sim)\n",
    "                observed_I = data['active reported daily cases'].values\n",
    "                SSE = np.sum((sim_I_at_data_days - observed_I)**2)\n",
    "                SSE_array.append(SSE)\n",
    "                param_combinations.append((b, s, g))\n",
    "\n",
    "    min_SSE_idx = np.argmin(SSE_array)\n",
    "    best_beta, best_sigma, best_gamma = param_combinations[min_SSE_idx]\n",
    "    best_SSE = SSE_array[min_SSE_idx]\n",
    "    return best_beta, best_sigma, best_gamma, best_SSE\n",
    "\n",
    "best_beta, best_sigma, best_gamma, best_SSE = fit_seir_parameters(\n",
    "    t, N, N-1, 0, 1, 0, exp_data)\n",
    "print(f\"Best parameters: beta={best_beta}, sigma={best_sigma}, gamma={best_gamma}, SSE={best_SSE}\")\n",
    "\n",
    "# ============================================================\n",
    "# SINGLE VACCINE EVENT FUNCTION\n",
    "# Vaccinate 2000 students on day 70 with 90% efficacy\n",
    "# ============================================================\n",
    "def euler_seir_vaccine(beta, sigma, gamma, S0, E0, I0, R0, timepoints, N,\n",
    "                        vax_day=70, vax_count=2000, vax_efficacy=0.90):\n",
    "    dt = timepoints[1] - timepoints[0]\n",
    "    S = [S0]\n",
    "    E = [E0]\n",
    "    I = [I0]\n",
    "    R = [R0]\n",
    "\n",
    "    vax_applied = False\n",
    "\n",
    "    for i in range(1, len(timepoints)):\n",
    "        if not vax_applied and timepoints[i] >= vax_day:\n",
    "            effectively_vaccinated = vax_count * vax_efficacy\n",
    "            actually_vaccinated = min(effectively_vaccinated, S[-1])\n",
    "            S[-1] -= actually_vaccinated\n",
    "            R[-1] += actually_vaccinated\n",
    "            vax_applied = True\n",
    "\n",
    "        dS = -beta * S[-1] * I[-1] / N\n",
    "        dE = beta * S[-1] * I[-1] / N - sigma * E[-1]\n",
    "        dI = sigma * E[-1] - gamma * I[-1]\n",
    "        dR = gamma * I[-1]\n",
    "\n",
    "        S.append(S[-1] + dt * dS)\n",
    "        E.append(E[-1] + dt * dE)\n",
    "        I.append(I[-1] + dt * dI)\n",
    "        R.append(R[-1] + dt * dR)\n",
    "\n",
    "    return S, E, I, R\n",
    "\n",
    "# ============================================================\n",
    "# RUN BASELINE AND SINGLE EVENT\n",
