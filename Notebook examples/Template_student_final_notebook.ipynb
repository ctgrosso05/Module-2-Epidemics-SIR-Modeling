    "\n",
    "print(f\"\\n--- PEAK SUMMARY: SINGLE VACCINE EVENT ---\")\n",
    "print(f\"Without vaccine:  Day {peak_day_base:.1f}, Peak cases = {peak_I_base:.1f}\")\n",
    "print(f\"With vaccine:     Day {peak_day_vax:.1f}, Peak cases = {peak_I_vax:.1f}\")\n",
    "print(f\"Reduction:        {peak_I_base - peak_I_vax:.1f} fewer cases ({(1 - peak_I_vax/peak_I_base)*100:.1f}% decrease)\")\n",
    "print(f\"Peak delayed by:  {peak_day_vax - peak_day_base:.1f} days\")\n",
    "\n",
    "# ============================================================\n",
    "# PLOT\n",
    "# ============================================================\n",
    "plt.figure(figsize=(10, 6))\n",
    "plt.plot(t_extended, I_base, label='No Intervention', color='red', linestyle='--')\n",
    "plt.plot(t_extended, I_vax, label='Vaccine: 2000 on Day 70 (90% efficacy)', color='blue')\n",
    "plt.axvline(x=70, color='green', linestyle=':', label='Vaccination Event (Day 70)')\n",
    "plt.scatter(exp_data['day'], exp_data['active reported daily cases'],\n",
    "            color='red', zorder=5, label='Observed Data (Release #2)')\n",
    "plt.xlabel('Day')\n",
    "plt.ylabel('Active Infected')\n",
    "plt.title('SEIR Model: Single Vaccine Event vs No Intervention')\n",
    "plt.legend()\n",
    "plt.tight_layout()\n",
    "plt.show()"
